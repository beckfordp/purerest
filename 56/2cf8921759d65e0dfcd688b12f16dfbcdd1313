- build.sbt (pureconfig-core added to inventoryService's libraryDependencies)
- modules/inventory-service/src/main/resources/application.conf (new)
- modules/inventory-service/src/main/scala/inventoryservice/InventoryServiceConfig.scala (new)
- modules/inventory-service/src/main/scala/inventoryservice/Main.scala
- modules/inventory-service/src/test/scala/inventoryservice/InventoryServiceConfigSuite.scala (new)
- modules/order-service/src/main/scala/orderservice/Main.scala (scalafmt only, from Phase 1)

