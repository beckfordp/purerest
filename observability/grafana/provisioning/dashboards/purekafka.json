{
  "title": "purekafka resilience + observability",
  "uid": "purekafka-resilience-observability",
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Retry Attempts by Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(purekafka_retry_attempts_total[1m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Circuit Breaker: State Transitions & Rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(purekafka_circuit_breaker_state_transitions_total[1m])) by (from_state, to_state)",
          "legendFormat": "{{from_state}} -> {{to_state}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(purekafka_circuit_breaker_calls_rejected_total[1m]))",
          "legendFormat": "rejected",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Circuit Breaker: Current State",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "purekafka_circuit_breaker_state == 1",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Dead-Letter Publish Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(purekafka_dlq_published_total[1m]))",
          "legendFormat": "dlq published",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Consumer Stream Restarts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(purekafka_stream_restarts_total[1m]))",
          "legendFormat": "restarts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Consumer Lag (by topic/partition)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "expr": "purekafka_consumer_lag",
          "legendFormat": "{{messaging_destination_name}}/{{messaging_kafka_destination_partition}}",
          "refId": "A"
        }
      ]
    }
  ]
}
